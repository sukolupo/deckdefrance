[Unit]
Description=deckdefrance Tacx Trainer Controller Mapper
After=network-online.target bluetooth.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/home/deck/git/deckdefrance/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000
WorkingDirectory=/home/deck/git/deckdefrance
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
